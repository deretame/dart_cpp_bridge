# Python (codegen scripts)
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.venv/
venv/

# Codegen: legacy in-repo cache (toolchain is user-level now)
# (codegen/ directory removed; dcb_gen_tool uses user-level cache)

# OS
.DS_Store
Thumbs.db
Desktop.ini

# FetchContent / CMake deps
_deps/
**/_deps/

# Vendored stdexec: local clone kept out of the repo on purpose (see
# AGENTS.md "Current initiative"). Anchored to the repo root so the tracked
# dart/native/third_party/ (Dart API headers) is unaffected.
/third_party/

# Test / coverage
coverage/
.nyc_output/
*.lcov

# Ensure vendored Dart API headers are always tracked even if global gitignore
# matches third_party/ patterns (some editors show such folders as grey).
!dart/native/third_party/
